// Application-level settings for the macOS Runner target.
// Flutter supplies FLUTTER_BUILD_NAME and FLUTTER_BUILD_NUMBER from pubspec.yaml.

// Product identity shown in Finder, the Dock, and the application menu.
PRODUCT_NAME = AI Orchestrator

// Keep the historical AI Orchestrator bundle identifier stable.
PRODUCT_BUNDLE_IDENTIFIER = com.aiorchestrator

PRODUCT_COPYRIGHT = Copyright © 2026 AI Orchestrator. All rights reserved.
